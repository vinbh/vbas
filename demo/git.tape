Output demo/git.gif

Set Shell "zsh"
Set FontSize 15
Set Width 860
Set Height 420
Set Theme "Dracula"
Set Padding 20
Set TypingSpeed 90ms
Set PlaybackSpeed 1.0

Hide
Type "export VBAS_SPECS_DIR=/home/vb666/.config/vbas/specs VBAS_BIN=/home/vb666/.local/bin/vbas"
Enter
Type "source /home/vb666/.config/vbas/vbas.zsh"
Enter
Type "PS1='$ '"
Enter
Type "clear"
Enter
Show

Sleep 600ms

# open full dropdown
Type "git "
Sleep 2200ms

# type to filter
Type "c"
Sleep 700ms
Down
Down
Down
Sleep 500ms

# select commit
Enter
Sleep 1600ms

# filter flags
Type "--m"
Sleep 700ms
Enter
Sleep 900ms
