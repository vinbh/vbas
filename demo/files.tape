Output demo/files.gif

Set Shell "zsh"
Set FontSize 15
Set Width 860
Set Height 380
Set Theme "Dracula"
Set Padding 20
Set TypingSpeed 90ms
Set PlaybackSpeed 1.0

Hide
Type "mkdir -p /tmp/vbas-files/src"
Enter
Type "touch /tmp/vbas-files/README.md /tmp/vbas-files/main.go /tmp/vbas-files/config.yaml /tmp/vbas-files/Makefile"
Enter
Type "touch /tmp/vbas-files/src/handler.go /tmp/vbas-files/src/routes.go"
Enter
Type "cd /tmp/vbas-files"
Enter
Type "export VBAS_SPECS_DIR=/home/vb666/.config/vbas/specs VBAS_BIN=/home/vb666/.local/bin/vbas"
Enter
Type "source /home/vb666/.config/vbas/vbas.zsh"
Enter
Type "PS1='$ '"
Enter
Type "clear"
Enter
Show

Sleep 600ms

# vim with file completion
Type "vim "
Sleep 1800ms
Down
Sleep 400ms
Down
Sleep 400ms
Enter
Sleep 900ms
